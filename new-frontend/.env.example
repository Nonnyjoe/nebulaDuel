# Copy to .env.local and fill from your `cartesi run` output.
# Cartesi CLI v2 prints the node URL/port; the inspect, JSON-RPC and anvil
# endpoints are all paths under it.
VITE_INPUTBOX_ADDRESS=0x1b51e2992A2755Ba4D6F7094032DF91991a0Cfac
VITE_DAPP_ADDRESS=0x38eab7732c725b221f9b20547d12aea8389b4d5d
VITE_INSPECT_URL=http://127.0.0.1:8080
VITE_JSONRPC_URL=http://127.0.0.1:8080/rpc
VITE_CHAIN_RPC=http://127.0.0.1:8080/anvil
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Anvil (local)

# Portals + tokens (from `cartesi run` deployment output)
VITE_ERC20_PORTAL=0x9C21AEb2093C32DDbC53eEF24B873BDCd1aDa1DB
VITE_CTSI_ADDRESS=0x92C6bcA388E99d6B304f1Af3c3Cd749Ff0b591e2
VITE_ERC721_PORTAL=0x9E8851dadb2b77103928518846c4678d48b5e371
VITE_NEBULA_NFT_ADDRESS=0x1c5AB37576Af4e6BEeCB66Fa6a9FdBc608F44B78

# Wallet — thirdweb client id (https://thirdweb.com/dashboard). A dev fallback
# is baked in, but set your own for reliable WalletConnect.
VITE_THIRDWEB_CLIENT_ID=

# Optional — avatar uploads (Pinata). Never commit real keys.
VITE_PINATA_API_KEY=
VITE_PINATA_SECRET_API_KEY=
